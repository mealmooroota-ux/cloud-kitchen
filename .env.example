# ---------- Server only (NEVER prefix with NEXT_PUBLIC_) ----------
SUPABASE_SERVICE_ROLE_KEY=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment provider: "phonepe" (automatic verification, recommended) or "manual_upi" (staff verifies in admin)
PAYMENT_PROVIDER=manual_upi

# PhonePe Payment Gateway (PhonePe Business dashboard > Developer settings)
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Manual UPI fallback: the UPI ID money is sent to
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=

# Routing for ETA: "google" (Routes API) or "ors" (OpenRouteService). Leave blank to show prep-time-only estimates.
MAPS_PROVIDER=
MAPS_API_KEY=

# Admin: mobile numbers that get ADMIN access when they sign in (comma separated, 10 digits)
ADMIN_PHONES=

# Cron/maintenance secret (Vercel Cron header check)
CRON_SECRET=
